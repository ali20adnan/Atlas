{
  "expo": {
    "name": "Atlas",
    "slug": "appqrwerehouse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "qrwerehouse",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alnabaa.qrwerehouse",
      "infoPlist": {
        "NSCameraUsageDescription": "Atlas uses the camera to scan barcodes and QR codes of warehouse items."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.alnabaa.qrwerehouse",
      "permissions": ["CAMERA"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-localization",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F172A",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Atlas to scan barcodes and QR codes of warehouse items.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ERROR_CHECK_ONLY",
      "fallbackToCacheTimeout": 0
    }
  }
}
